digraph VersionB {
rankdir=LR;
graph [fontname="Helvetica", nodesep=0.20, ranksep=0.40, splines=true, pad=0.1];
node [fontname="Helvetica", fontsize=8];
edge [arrowsize=0.55, color="#40546b"];
"p_completed" [shape=circle, style=filled, fillcolor="#ffffff", label="p_completed"];
"p_grip_recovery" [shape=circle, style=filled, fillcolor="#ffffff", label="p_grip_recovery"];
"p_inspect_done" [shape=circle, style=filled, fillcolor="#fde9d9", label="p_inspect_done"];
"p_inspecting" [shape=circle, style=filled, fillcolor="#ffffff", label="p_inspecting"];
"p_inspection_free" [shape=circle, style=filled, fillcolor="#dbe4ee", label="p_inspection_free\n(1)"];
"p_loading" [shape=circle, style=filled, fillcolor="#ffffff", label="p_loading"];
"p_machine_free" [shape=circle, style=filled, fillcolor="#dbe4ee", label="p_machine_free\n(1)"];
"p_processing" [shape=circle, style=filled, fillcolor="#ffffff", label="p_processing"];
"p_raw" [shape=circle, style=filled, fillcolor="#ffffff", label="p_raw\n(2)"];
"p_rework_queue" [shape=circle, style=filled, fillcolor="#ffffff", label="p_rework_queue"];
"p_rework_transfer" [shape=circle, style=filled, fillcolor="#ffffff", label="p_rework_transfer"];
"p_robot_free" [shape=circle, style=filled, fillcolor="#dbe4ee", label="p_robot_free\n(1)"];
"p_transferring" [shape=circle, style=filled, fillcolor="#ffffff", label="p_transferring"];
"p_unloading" [shape=circle, style=filled, fillcolor="#ffffff", label="p_unloading"];
"p_wait_inspection" [shape=circle, style=filled, fillcolor="#ffffff", label="p_wait_inspection"];
"p_wait_machine" [shape=circle, style=filled, fillcolor="#ffffff", label="p_wait_machine"];
"p_wait_transfer" [shape=circle, style=filled, fillcolor="#ffffff", label="p_wait_transfer"];
"p_wait_unload" [shape=circle, style=filled, fillcolor="#ffffff", label="p_wait_unload"];
"t_FinishLoading" [shape=box, style="rounded,filled", fillcolor="#e6f0e2", color="#2f6b3a", fontcolor="#1d4424", label="t_FinishLoading\n[2,2]\n/load_done/"];
"t_FinishProcessing" [shape=box, style="rounded,filled", fillcolor="#e6f0e2", color="#2f6b3a", fontcolor="#1d4424", label="t_FinishProcessing\n[10,10]\n/machining_done/"];
"t_FinishReworkTransfer" [shape=box, style="rounded,filled", fillcolor="#e6f0e2", color="#2f6b3a", fontcolor="#1d4424", label="t_FinishReworkTransfer\n[2,2]\n/rework_returned/"];
"t_FinishTransfer" [shape=box, style="rounded,filled", fillcolor="#e6f0e2", color="#2f6b3a", fontcolor="#1d4424", label="t_FinishTransfer\n[2,2]\n/transfer_done/"];
"t_FinishUnloading" [shape=box, style="rounded,filled", fillcolor="#e6f0e2", color="#2f6b3a", fontcolor="#1d4424", label="t_FinishUnloading\n[2,2]\n/unload_done/"];
"t_GripperSlipFault" [shape=box, style="rounded,filled", fillcolor="#f6e3d3", color="#b5651d", fontcolor="#8a4a12", label="t_GripperSlipFault\n[1,3]"];
"t_InspectComplete" [shape=box, style="rounded,filled", fillcolor="#fde9d9", color="#04182e", fontcolor="#04182e", label="t_InspectComplete\n[4,4]"];
"t_InspectionPass" [shape=box, style="rounded,filled", fillcolor="#e6f0e2", color="#2f6b3a", fontcolor="#1d4424", label="t_InspectionPass\n[1,1]\n/inspection_pass/"];
"t_InspectionRework" [shape=box, style="rounded,filled", fillcolor="#e6f0e2", color="#2f6b3a", fontcolor="#1d4424", label="t_InspectionRework\n[1,1]\n/inspection_rework/"];
"t_RecoverLoading" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="t_RecoverLoading\n[16,16]"];
"t_StartInspection" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="t_StartInspection\n[0,3]"];
"t_StartLoading" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="t_StartLoading\n[0,3]"];
"t_StartProcessing" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="t_StartProcessing\n[0,3]"];
"t_StartReworkTransfer" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="t_StartReworkTransfer\n[0,3]"];
"t_StartTransfer" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="t_StartTransfer\n[0,3]"];
"t_StartUnloading" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="t_StartUnloading\n[0,3]"];
"p_loading" -> "t_FinishLoading";
"t_FinishLoading" -> "p_robot_free";
"t_FinishLoading" -> "p_wait_machine";
"p_processing" -> "t_FinishProcessing";
"t_FinishProcessing" -> "p_machine_free";
"t_FinishProcessing" -> "p_wait_transfer";
"p_rework_transfer" -> "t_FinishReworkTransfer";
"t_FinishReworkTransfer" -> "p_robot_free";
"t_FinishReworkTransfer" -> "p_wait_machine";
"p_transferring" -> "t_FinishTransfer";
"t_FinishTransfer" -> "p_robot_free";
"t_FinishTransfer" -> "p_wait_inspection";
"p_unloading" -> "t_FinishUnloading";
"t_FinishUnloading" -> "p_completed";
"t_FinishUnloading" -> "p_robot_free";
"p_loading" -> "t_GripperSlipFault";
"t_GripperSlipFault" -> "p_grip_recovery";
"p_inspecting" -> "t_InspectComplete";
"t_InspectComplete" -> "p_inspect_done";
"p_inspect_done" -> "t_InspectionPass";
"t_InspectionPass" -> "p_inspection_free";
"t_InspectionPass" -> "p_wait_unload";
"p_inspect_done" -> "t_InspectionRework";
"t_InspectionRework" -> "p_inspection_free";
"t_InspectionRework" -> "p_rework_queue";
"p_grip_recovery" -> "t_RecoverLoading";
"t_RecoverLoading" -> "p_loading";
"p_inspection_free" -> "t_StartInspection";
"p_wait_inspection" -> "t_StartInspection";
"t_StartInspection" -> "p_inspecting";
"p_raw" -> "t_StartLoading";
"p_robot_free" -> "t_StartLoading";
"t_StartLoading" -> "p_loading";
"p_machine_free" -> "t_StartProcessing";
"p_wait_machine" -> "t_StartProcessing";
"t_StartProcessing" -> "p_processing";
"p_rework_queue" -> "t_StartReworkTransfer";
"p_robot_free" -> "t_StartReworkTransfer";
"t_StartReworkTransfer" -> "p_rework_transfer";
"p_robot_free" -> "t_StartTransfer";
"p_wait_transfer" -> "t_StartTransfer";
"t_StartTransfer" -> "p_transferring";
"p_robot_free" -> "t_StartUnloading";
"p_wait_unload" -> "t_StartUnloading";
"t_StartUnloading" -> "p_unloading";
}
